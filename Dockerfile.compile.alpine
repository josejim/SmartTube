# SmartTube Build Environment (Alpine Linux - minimal)
# JDK 17 + Android SDK + Gradle in ~1GB
FROM alpine:3.18

ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# Install base tools + JDK 17 + bash (for gradle) + glibc (for protoc)
RUN apk add --no-cache \
    wget \
    unzip \
    git \
    openjdk17-jdk \
    bash \
    gcompat

# Download Android SDK
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools && \
    cd $ANDROID_SDK_ROOT/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip && \
    mv cmdline-tools latest && \
    rm cmdline-tools.zip

# Accept licenses and install required SDK components
RUN yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --licenses 2>/dev/null || true
RUN $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --install \
    "platforms;android-34" \
    "build-tools;34.0.0" \
    "platform-tools" 2>/dev/null || true

# Copy project
COPY . /project
WORKDIR /project

# Make gradlew executable
RUN chmod +x gradlew

# Default: compile the ststable variant
CMD ["./gradlew", ":common:compileStstableDebugJavaWithJavac", "--no-daemon"]